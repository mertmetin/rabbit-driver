{
  "expo": {
    "name": "Rabbit Driver",
    "slug": "rabbit-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.rabbit.driver"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00754a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ca.rabbit.driver"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rabbit Driver shares your location with the customer while you are delivering their order.",
          "locationAlwaysAndWhenInUsePermission": "Rabbit Driver keeps sharing your location with the customer during a delivery, even when your phone is locked. Sharing stops when the order is delivered.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rabbit Driver uses the camera to photograph where you left a delivery.",
          "photosPermission": "Rabbit Driver lets you choose a doorstep photo from your library."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#00754a",
          "imageWidth": 220
        }
      ]
    ],
    "scheme": "rabbitdriver",
    "experiments": {
      "typedRoutes": true
    }
  }
}
